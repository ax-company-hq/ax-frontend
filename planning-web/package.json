{
  "name": "@ax/planning-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "기획개발(planning) 부서 화면 — 고객사 업무 시스템의 기획개발팀 탭 (목 데이터 시연판)",
  "scripts": {
    "dev": "vite",
    "dev:depts": "vite --port 3003",
    "bus": "node server/mock-bus.mjs",
