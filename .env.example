# 복사해서 .env로 쓴다 (커밋 금지). 두 앱 모두 이 루트 .env를 읽는다 (vite envDir = 레포 루트).
# 백엔드 포트는 ax-backend/CLAUDE.md 포트 표 기준
VITE_SHOP_API_URL=http://localhost:8010
VITE_DASHBOARD_API_URL=http://localhost:8020
# 앱끼리 서로 여는 링크 (쇼핑몰 '상담원 콘솔' ↔ 대시보드 '쇼핑몰 보기')
VITE_SHOP_WEB_URL=http://localhost:3000
VITE_DASHBOARD_WEB_URL=http://localhost:3001
# 재무·안전 화면 (/finance): 안전 레이어·재무 에이전트 조회 API
VITE_SAFETY_API_URL=http://localhost:8001
VITE_FINANCE_AGENT_URL=http://localhost:8105
# C 보류 승인·거절에 쓰는 사람 토큰 (목 모드 데모: human:<이름>). 비우면 버튼이 꺼진다
VITE_SAFETY_HUMAN_TOKEN=
# AI 대화방 (/agents/chat): 총괄(orchestrator) 주소. 총괄 서버에 CORS가 없어서 기본값 /orch는
# dashboard-web 개발 서버 프록시(→ http://localhost:8000)를 탄다. 프록시 대상을 바꾸려면 ORCHESTRATOR_PROXY_TARGET
VITE_ORCHESTRATOR_URL=/orch
# ORCHESTRATOR_PROXY_TARGET=http://localhost:8000
# planning-web (기획개발) — 고객사마다 바뀌는 값. 비우면 데모 고객사 캣북스 기본값
VITE_COMPANY_NAME=캣북스
VITE_COMPANY_TAGLINE=책과 문구, 고양이가 지키는 서점
# VITE_COMPANY_LOGO=   # 사이드바 로고 주소. 비우면 VITE_SHOP_WEB_URL 사이트의 파비콘을 자동으로 쓴다
# 시연용 연동 버스 (npm run bus -w planning-web)
VITE_BUS_URL=http://127.0.0.1:8790
# 한 포트 게이트웨이(nginx/Dockerfile)가 빌드 인자로 넣는 값. 로컬 개발에는 필요 없다 (비우면 아래 기본값)
# 기획개발 화면 주소 (관리자 상단 '기획개발' 링크). 게이트웨이에서는 /admin/planning/
VITE_PLANNING_WEB_URL=http://localhost:3002
# 관리자 데모 로그인 (고객이 실수로 들어오지 않게 하는 정도, 실제 인증 아님). on일 때만 켜진다
VITE_ADMIN_LOGIN=
VITE_ADMIN_DEMO_PASSWORD=
# 통합 에이전트 화면(orchestrator-web): 총괄 백엔드 주소. 개발 서버가 /orch로 대신 부른다. 총괄이 8000이 아닌 포트에 뜨면 바꾼다
# ORCHESTRATOR_PROXY_TARGET=http://localhost:8000
# 상담원 화면(dashboard-web)의 총괄·부서별 호출 현황(개발용, 임시): 목 모드에서만 `mock:admin`을 넣는다. 개발 서버는 비워도 기본값으로 연결되고, 운영 빌드는 비우면 꺼진다. 진짜 로그인은 사람 인증 뒤에 붙는다
VITE_SHOP_ADMIN_TOKEN=
# 총괄·부서별 호출 현황이 부르는 shop-api 주소(기본 http://localhost:8010)
# VITE_SHOP_ADMIN_API_URL=http://localhost:8010
