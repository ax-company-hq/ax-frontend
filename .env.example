# 복사해서 .env로 쓴다 (커밋 금지). 두 앱 모두 이 루트 .env를 읽는다 (vite envDir = 레포 루트).
# 백엔드 포트는 ax-backend/CLAUDE.md 포트 표 기준
VITE_SHOP_API_URL=http://localhost:8010
VITE_DASHBOARD_API_URL=http://localhost:8020
# 앱끼리 서로 여는 링크 (쇼핑몰 '상담원 콘솔' ↔ 대시보드 '쇼핑몰 보기')
VITE_SHOP_WEB_URL=http://localhost:3000
VITE_DASHBOARD_WEB_URL=http://localhost:3001
